<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ff_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="35dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/arrowback"
                android:background="@drawable/iconbutton"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CHANGE PASSWORD"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />

        </LinearLayout>


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="35dp"
            android:paddingBottom="30dp">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:padding="19dp"
                android:src="@drawable/person"
                android:background="@drawable/avatar"
                android:contentDescription="Security" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SECURE YOUR ACCOUNT"
                android:textColor="#E8C45E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Choose a strong password that you don't use anywhere else."
                android:textColor="#777777"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>


        <!-- CURRENT PASSWORD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="CURRENT PASSWORD"
            android:textColor="#E8C45E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/currentPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/inputgold"
            android:hint="Enter current password"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#7A6520"
            android:textSize="14sp"
            android:inputType="textPassword" />


        <!-- NEW PASSWORD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="NEW PASSWORD"
            android:textColor="#E8C45E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/newPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/inputgold"
            android:hint="Enter new password"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#7A6520"
            android:textSize="14sp"
            android:inputType="textPassword" />


        <!-- CONFIRM PASSWORD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="CONFIRM NEW PASSWORD"
            android:textColor="#E8C45E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/inputgold"
            android:hint="Confirm new password"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#7A6520"
            android:textSize="14sp"
            android:inputType="textPassword" />


        <!-- CHANGE PASSWORD BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/changePasswordButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="CHANGE PASSWORD"
            android:textColor="@color/ff_on_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/gold"
            app:backgroundTint="@null" />


        <!-- PASSWORD REQUIREMENTS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/cardoutline"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD REQUIREMENTS"
                android:textColor="#E8C45E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="• At least 8 characters&#10;• Use a combination of letters and numbers&#10;• Avoid using easily guessed information"
                android:textColor="#888888"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>