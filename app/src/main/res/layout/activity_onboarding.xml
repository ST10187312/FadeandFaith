<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">



    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboardingViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/contentContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Style."
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:fontFamily="sans"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/onboardingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experience premium barbering designed around your style."
            android:textColor="#999999"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="25dp" />



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <View
                android:id="@+id/indicator1"
                android:layout_width="25dp"
                android:layout_height="3dp"
                android:background="#D4AF37"
                android:layout_marginEnd="6dp" />

            <View
                android:id="@+id/indicator2"
                android:layout_width="25dp"
                android:layout_height="3dp"
                android:background="#D4AF37"
                android:alpha="0.3"
                android:layout_marginEnd="6dp" />

            <View
                android:id="@+id/indicator3"
                android:layout_width="25dp"
                android:layout_height="3dp"
                android:background="#D4AF37"
                android:alpha="0.3" />

        </LinearLayout>



        <Button
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="NEXT"
            android:textColor="#050505"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/goldbutton"
            android:elevation="4dp" />

        <!-- Skip -->

        <TextView
            android:id="@+id/skipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKIP"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:padding="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>