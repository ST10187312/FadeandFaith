<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ff_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/iconbutton"
            android:src="@drawable/arrowback"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="serif"
            android:text="@string/booking_title"
            android:textColor="@color/ff_gold"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/booking_subtitle"
                android:textColor="@color/ff_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/booking_subtext"
                android:textColor="@color/ff_text_secondary"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/label_service"
                android:textColor="@color/ff_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <LinearLayout
                android:id="@+id/serviceSelection"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/cardoutline"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/selectedServiceText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/booking_select_service"
                    android:textColor="@color/ff_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="R180"
                    android:textColor="@color/ff_gold"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_barber"
                android:textColor="@color/ff_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <LinearLayout
                android:id="@+id/barberSelection"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/cardoutline"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/selectedBarberText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_any_barber"
                    android:textColor="@color/ff_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_date"
                android:textColor="@color/ff_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="7dp"
                android:background="@drawable/cardoutline">

                <TextView
                    android:id="@+id/selectedDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/booking_select_date"
                    android:textColor="@color/ff_text"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateButton"
                    android:layout_width="105dp"
                    android:layout_height="46dp"
                    android:text="@string/action_choose"
                    android:textColor="@color/ff_on_gold"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/gold"
                    app:backgroundTint="@null" />

            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_time"
                android:textColor="@color/ff_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="7dp"
                android:background="@drawable/cardoutline">

                <TextView
                    android:id="@+id/selectedTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/booking_select_time"
                    android:textColor="@color/ff_text"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timeButton"
                    android:layout_width="105dp"
                    android:layout_height="46dp"
                    android:text="@string/action_choose"
                    android:textColor="@color/ff_on_gold"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/gold"
                    app:backgroundTint="@null" />

            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="25dp"
                android:text="@string/action_continue"
                android:textColor="@color/ff_on_gold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/gold"
                app:backgroundTint="@null" />
        </LinearLayout>

    </ScrollView>

</LinearLayout>